{
  "name": "@moltbooky/db",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/db/schema.ts"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "generate": "pnpm --dir ../.. exec drizzle-kit generate --config drizzle.config.ts",
    "migrate": "set -a; [ -f ../../apps/api/.dev.vars ] && . ../../apps/api/.dev.vars; set +a; pnpm --dir ../.. exec drizzle-kit migrate --config drizzle.config.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.45.2"
  }
}
