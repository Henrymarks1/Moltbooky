DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Optional. If either key is missing, the resolver leaves challenges UNRESOLVED.
EXA_API_KEY=""
OPENAI_API_KEY=""

# Optional. Enables Browser Use Cloud live browser evidence gathering.
BROWSER_USE_API_KEY=""
BROWSER_USE_ENABLED="true"
BROWSER_USE_MODEL="claude-sonnet-4.6"

# Required. API Durable Object alarms use this bearer token to start resolver runs.
RESOLVER_TEST_TOKEN=""

# Optional. Enables authenticated Pipedream Connect proxy API fetches during resolution.
PIPEDREAM_CLIENT_ID=""
PIPEDREAM_CLIENT_SECRET=""
PIPEDREAM_PROJECT_ID=""
PIPEDREAM_PROJECT_ENVIRONMENT="development"
